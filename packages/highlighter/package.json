{
  "name": "@nsh/highlighter",
  "version": "0.1.1",
  "description": "Neural code highlighting directly in the browser",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/highlighter.d.ts",
      "import": "./dist/highlighter.js"
    },
    "./languages/*": {
      "types": "./dist/languages/*.d.ts",
      "import": "./dist/languages/*.js"
    },
    "./theme.css": "./dist/theme.css",
    "./themes.css": "./dist/themes/all.css",
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./themes/*.css": "./dist/themes/*.css",
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@nsh/core": "workspace:*",
    "@nsh/html": "workspace:*",
    "@nsh/browser": "workspace:*"
  },
  "devDependencies": {
    "@nsh/themes": "workspace:*",
    "@nsh/models": "workspace:*"
  },
  "peerDependencies": {
    "@nsh/models": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nsh/models": {
      "optional": true
    }
  }
}
