{
  "name": "@nsh/core",
  "version": "0.1.0",
  "description": "Framework-independent semantic highlighting contracts and pack routing",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composition/html": {
      "types": "./dist/composition/html.d.ts",
      "import": "./dist/composition/html.js"
    },
    "./composition/vue": {
      "types": "./dist/composition/vue.d.ts",
      "import": "./dist/composition/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json"
  }
}
