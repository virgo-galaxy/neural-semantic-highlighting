{
  "name": "@nsh/themes",
  "version": "0.1.0",
  "description": "Web CSS themes for Neural Semantic Highlighting",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./default.css": "./dist/default.css",
    "./base.css": "./dist/base.css",
    "./all.css": "./dist/all.css",
    "./languages/*": "./dist/languages/*",
    "./*.css": "./dist/*.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
