{
  "name": "neural-semantic-highlighting",
  "version": "0.1.0",
  "description": "Runtime-agnostic neural semantic highlighting engine",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "pnpm -r --if-present run clean",
    "build": "pnpm -r --if-present run build",
    "build:packages": "pnpm -r --filter './packages/**' --if-present run build",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "dev": "pnpm build:packages && cd apps/playground && exec vite",
    "dataset:collect:typescript": "tsx packs/typescript/dataset/collect.ts",
    "dataset:label:typescript": "tsx packs/typescript/dataset/label-sample.ts",
    "dataset:review:typescript": "tsx packs/typescript/dataset/review-sample.ts",
    "dataset:split:typescript": "tsx packs/typescript/dataset/split-sample.ts",
    "dataset:validate:typescript": "tsx packs/typescript/dataset/validate-sample.ts",
    "dataset:collect:css": "tsx packs/css/dataset/pipeline.ts collect",
    "dataset:label:css": "tsx packs/css/dataset/pipeline.ts label",
    "dataset:validate:css": "tsx packs/css/dataset/pipeline.ts validate",
    "all": "pnpm build && tsc -p tsconfig.json && pnpm lint && pnpm format:check && vitest run"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nsh/core": "workspace:*",
    "@nsh/html": "workspace:*",
    "@nsh/local": "workspace:*",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "vscode-css-languageservice": "6.3.10",
    "vscode-languageserver-textdocument": "1.0.16",
    "vue-eslint-parser": "^10.4.1"
  }
}
