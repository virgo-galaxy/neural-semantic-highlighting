{
  "name": "@nsh/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm typecheck && vite build --target es2022",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nsh/core": "workspace:*",
    "@nsh/html": "workspace:*",
    "@nsh/themes": "workspace:*",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.42",
    "@nsh/highlighter": "workspace:*"
  },
  "devDependencies": {
    "@nsh/local": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.104.0",
    "vite": "8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
