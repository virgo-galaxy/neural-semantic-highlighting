{
  "name": "@nsh/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm typecheck && vite build --target es2022",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nsh/core": "workspace:*",
    "@nsh/html": "workspace:*",
    "@nsh/highlighter": "workspace:*",
    "@nsh/models": "workspace:*",
    "@virgo-design/fonts": "0.1.0",
    "@virgo-design/icons": "0.1.3",
    "@virgo-design/themes": "0.1.0",
    "@virgo-design/tokens": "0.1.0",
    "@virgo-design/ui": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@nsh/local": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "sass": "^1.104.0",
    "vite": "8.2.2"
  }
}
