/*
  A JSONC block comment can describe a configuration over several lines.
  Braces {}, brackets [], quotes "text" and // markers remain comment text.
  Nested block comments are not part of the JSONC contract.
*/
{
  "features": {
    "preview": true, /* Enable the preview pane. */
    "telemetry": false,
  },
  "limit": 20, // Comments do not include their line-ending bytes.
}
