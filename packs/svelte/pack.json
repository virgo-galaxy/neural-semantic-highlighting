{
  "label": "Svelte",
  "profiles": ["svelte"],
  "scope": "svelte-template-with-code-regions",
  "contextBytes": 512,
  "decoder": {
    "coalesceAdjacentTokenTypes": [
      "embedded-javascript",
      "embedded-typescript",
      "embedded-css",
      "embedded-scss",
      "embedded-less",
      "embedded-expression",
      "embedded-data",
      "comment",
      "string",
      "text"
    ]
  },
  "requiredTrainingFeatures": {
    "svelte": [
      "blocks",
      "directives",
      "snippets",
      "embedded-javascript",
      "embedded-typescript",
      "embedded-css"
    ]
  },
  "minimumTrainingFeatureGroups": 2
}
