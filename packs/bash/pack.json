{
  "label": "Shell",
  "profiles": ["posix", "bash", "zsh", "csh"],
  "scope": "shell-local-semantic-spans",
  "contextBytes": 512,
  "decoder": {
    "coalesceAdjacentTokenTypes": ["string"],
    "modifierRoles": {
      "declaration": ["function", "variable"],
      "default-library": ["function"]
    }
  },
  "requiredTrainingFeatures": {
    "posix": ["loops", "conditionals", "leading-loops"],
    "bash": ["loops", "conditionals", "leading-loops", "arrays"],
    "zsh": ["loops", "conditionals", "leading-loops", "arrays"],
    "csh": ["loops", "conditionals", "leading-loops", "arrays"]
  },
  "minimumTrainingFeatureGroups": 3
}
