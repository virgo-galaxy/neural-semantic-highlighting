      "source": "BEGIN {\n    FS = \",\"\n    OFS = \"\\t\"\n}\n\nNR == 1 { next }\n$3 >= 10 {\n    totals[$1] += $3\n    records++\n}\n\nEND {\n    for (name in totals)\n        printf \"%s\\t%.2f\\n\", name, totals[name]\n    print \"Processed\", records, \"records\"\n}\n",
